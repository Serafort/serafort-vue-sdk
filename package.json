{
  "name": "@serafort/vue",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "description": "Vue 3 Composition API composables, Pinia integration, and Vue Router guards for Serafort IAM.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "husky"
  },
  "dependencies": {
    "@serafort/core": "link:../Javascript"
  },
  "peerDependencies": {
    "pinia": ">=2.1.0",
    "vue": ">=3.3.0",
    "vue-router": ">=4.2.0"
  },
  "peerDependenciesMeta": {
    "pinia": {
      "optional": true
    },
    "vue-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "pinia": "^2.3.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  }
}
